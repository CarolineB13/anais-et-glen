<header class="site-header">
  <div class="site-header__inner">
    <a
      href="/#hero"
      class="site-header__brand"
      aria-label="Anaïs et Glen — Accueil"
    >
      Anaïs <span>&</span> Glen
    </a>

    <nav class="site-header__nav" aria-label="Navigation principale">
      <a href="/#programme">Notre journée</a>
      <a href="/#dresscode">Dress code</a>
      <a href="/#infos">Infos</a>
      <a href="/photos">Photos</a>

      <a href="/#rsvp" class="site-header__cta"> RSVP </a>
    </nav>

    <button
      class="site-header__menu"
      type="button"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<script>
  const button = document.querySelector(".site-header__menu");
  const nav = document.querySelector(".site-header__nav");

  if (button && nav) {
    button.addEventListener("click", () => {
      const open = nav.classList.toggle("is-open");

      button.classList.toggle("is-open", open);
      button.setAttribute("aria-expanded", String(open));
      document.body.classList.toggle("menu-open", open);
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        nav.classList.remove("is-open");
        button.classList.remove("is-open");
        button.setAttribute("aria-expanded", "false");
        document.body.classList.remove("menu-open");
      });
    });
  }
</script>

<style>
  .site-header {
    position: absolute;
    top: 0;
    left: 0;

    z-index: 50;

    width: 100%;
  }

  .site-header__inner {
    width: min(calc(100% - 3rem), var(--container));

    min-height: 92px;

    margin-inline: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 2rem;
  }

  .site-header__brand {
    position: relative;
    z-index: 60;

    font-family: var(--font-script);

    font-size: 2.35rem;
    line-height: 1;

    color: var(--green-deep);
  }

  .site-header__brand span {
    color: var(--terracotta);
  }

  .site-header__nav {
    display: flex;
    align-items: center;

    gap: 2rem;

    color: var(--green-deep);

    font-size: 0.8rem;
  }

  .site-header__nav > a:not(.site-header__cta) {
    position: relative;

    padding-block: 0.5rem;
  }

  .site-header__nav > a:not(.site-header__cta)::after {
    content: "";

    position: absolute;

    left: 50%;
    bottom: 0;

    width: 0;
    height: 1px;

    background: var(--terracotta);

    transform: translateX(-50%);

    transition: width 250ms ease;
  }

  .site-header__nav > a:not(.site-header__cta):hover::after {
    width: 100%;
  }

  .site-header__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 42px;

    padding-inline: 1.4rem;

    border: 1px solid rgba(64, 101, 86, 0.45);
    border-radius: 999px;

    transition:
      background 250ms ease,
      color 250ms ease,
      border-color 250ms ease;
  }

  .site-header__cta:hover {
    background: var(--green-deep);
    border-color: var(--green-deep);

    color: var(--ivory-light);
  }

  .site-header__menu {
    position: relative;
    z-index: 60;

    display: none;

    width: 48px;
    height: 48px;

    padding: 0;

    border: 1px solid rgba(64, 101, 86, 0.18);
    border-radius: 50%;

    background: rgba(255, 253, 248, 0.72);

    backdrop-filter: blur(10px);
  }

  .site-header__menu span {
    position: absolute;

    left: 14px;

    width: 18px;
    height: 1px;

    background: var(--green-deep);

    transition:
      transform 250ms ease,
      top 250ms ease;
  }

  .site-header__menu span:first-child {
    top: 20px;
  }

  .site-header__menu span:last-child {
    top: 27px;
  }

  .site-header__menu.is-open span:first-child {
    top: 24px;
    transform: rotate(45deg);
  }

  .site-header__menu.is-open span:last-child {
    top: 24px;
    transform: rotate(-45deg);
  }

  @media (max-width: 800px) {
    .site-header__inner {
      width: calc(100% - 2rem);
      min-height: 76px;
    }

    .site-header__brand {
      font-size: 2rem;
    }

    .site-header__menu {
      display: block;
    }

    .site-header__nav {
      position: fixed;

      inset: 0;

      z-index: 55;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      gap: 1.7rem;

      background: linear-gradient(
        rgba(255, 253, 248, 0.96),
        rgba(251, 247, 239, 0.98)
      );

      font-family: var(--font-serif);

      font-size: 2rem;

      transform: translateY(-100%);

      transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .site-header__nav::before {
      content: "";

      position: absolute;

      width: 220px;
      height: 220px;

      left: -60px;
      bottom: -50px;

      background: url("/images/decorations/deco5.png") center / contain
        no-repeat;

      opacity: 0.22;

      pointer-events: none;
    }

    .site-header__nav.is-open {
      transform: translateY(0);
    }

    .site-header__cta {
      margin-top: 1rem;

      min-height: 50px;

      padding-inline: 2rem;

      font-family: var(--font-body);

      font-size: 0.8rem;
    }
  }
</style>
