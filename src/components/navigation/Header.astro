<header class="site-header">
  <div class="site-header__inner">
    <a
      href="/#hero"
      class="site-header__brand"
      aria-label="Anaïs et Glen — Accueil"
    >
      Anaïs <span>&</span> Glen
    </a>

    <nav class="site-header__nav" aria-label="Navigation principale">
      <a href="/#programme">Notre journée</a>
      <a href="/#dresscode">Dress code</a>
      <a href="/#infos">Infos</a>
      <a href="/photos">Photos</a>

      <a href="/#rsvp" class="site-header__cta"> RSVP </a>
    </nav>

    <button
      class="site-header__menu"
      type="button"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector(".site-header");
  const button = document.querySelector(".site-header__menu");
  const nav = document.querySelector(".site-header__nav");

  const updateHeader = () => {
    if (!header) return;
    header.classList.toggle("is-scrolled", window.scrollY > 12);
  };

  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });

  if (button && nav) {
    button.addEventListener("click", () => {
      const open = nav.classList.toggle("is-open");

      button.classList.toggle("is-open", open);
      button.setAttribute("aria-expanded", String(open));
      document.body.classList.toggle("menu-open", open);
      header?.classList.toggle("menu-is-open", open);
    });

    const closeMenu = () => {
      nav.classList.remove("is-open");
      button.classList.remove("is-open");
      button.setAttribute("aria-expanded", "false");
      document.body.classList.remove("menu-open");
      header?.classList.remove("menu-is-open");
    };

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 800) closeMenu();
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;

    z-index: 70;

    width: 100%;

    background: rgba(251, 247, 239, 0);
    border-bottom: 1px solid transparent;

    transition:
      background 280ms ease,
      border-color 280ms ease,
      box-shadow 280ms ease;
  }

  .site-header.is-scrolled {
    background: rgba(251, 247, 239, 0.9);
    border-bottom-color: rgba(64, 101, 86, 0.1);
    box-shadow: 0 8px 28px rgba(64, 101, 86, 0.06);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .site-header__inner {
    width: min(calc(100% - 3rem), var(--container));

    min-height: 92px;

    margin-inline: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 2rem;
  }

  .site-header__brand {
    position: relative;
    z-index: 80;

    font-family: var(--font-script);

    font-size: 2.35rem;
    line-height: 1;

    color: var(--green-deep);
  }

  .site-header__brand span {
    color: var(--terracotta);
  }

  .site-header__nav {
    display: flex;
    align-items: center;

    gap: 2rem;

    color: var(--green-deep);

    font-size: 0.8rem;
  }

  .site-header__nav > a:not(.site-header__cta) {
    position: relative;

    padding-block: 0.5rem;
  }

  .site-header__nav > a:not(.site-header__cta)::after {
    content: "";

    position: absolute;

    left: 50%;
    bottom: 0;

    width: 0;
    height: 1px;

    background: var(--terracotta);

    transform: translateX(-50%);

    transition: width 250ms ease;
  }

  .site-header__nav > a:not(.site-header__cta):hover::after {
    width: 100%;
  }

  .site-header__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 42px;

    padding-inline: 1.4rem;

    border: 1px solid rgba(64, 101, 86, 0.45);
    border-radius: 999px;

    transition:
      background 250ms ease,
      color 250ms ease,
      border-color 250ms ease;
  }

  .site-header__cta:hover {
    background: var(--green-deep);
    border-color: var(--green-deep);

    color: var(--ivory-light);
  }

  .site-header__menu {
    position: relative;
    z-index: 80;

    display: none;

    width: 48px;
    height: 48px;

    padding: 0;

    border: 1px solid rgba(64, 101, 86, 0.18);
    border-radius: 50%;

    background: rgba(255, 253, 248, 0.72);

    backdrop-filter: blur(10px);
  }

  .site-header__menu span {
    position: absolute;

    left: 14px;

    width: 18px;
    height: 1px;

    background: var(--green-deep);

    transition:
      transform 250ms ease,
      top 250ms ease;
  }

  .site-header__menu span:first-child {
    top: 20px;
  }

  .site-header__menu span:last-child {
    top: 27px;
  }

  .site-header__menu.is-open span:first-child {
    top: 24px;
    transform: rotate(45deg);
  }

  .site-header__menu.is-open span:last-child {
    top: 24px;
    transform: rotate(-45deg);
  }

  @media (max-width: 800px) {
    .site-header,
    .site-header.is-scrolled,
    .site-header.menu-is-open {
      background: rgba(255, 253, 248, 0.97);
      border-bottom-color: rgba(64, 101, 86, 0.12);
      box-shadow: 0 6px 24px rgba(64, 101, 86, 0.05);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }

    .site-header {
      isolation: isolate;
    }

    .site-header__inner {
      position: relative;
      z-index: 2;
      width: calc(100% - 2rem);
      min-height: 76px;
    }

    .site-header__brand {
      max-width: calc(100% - 68px);
      font-size: clamp(1.75rem, 8vw, 2rem);
      white-space: nowrap;
    }

    .site-header__menu {
      display: block;
      flex: 0 0 48px;
    }

    .site-header__nav {
      /*
       * Le header utilise un backdrop-filter sur mobile. Dans certains
       * navigateurs cela crée un containing block pour les descendants
       * positionnés en fixed et le panneau du menu se retrouvait limité à
       * la hauteur du header. On ancre donc le panneau au header fixe avec
       * position:absolute + une hauteur de viewport explicite.
       */
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      z-index: 1;

      width: 100vw;
      height: calc(100vh - 76px);
      height: calc(100dvh - 76px);
      min-height: 420px;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;

      gap: 0;
      padding: clamp(2.25rem, 6vh, 3.75rem) 2rem 3rem;
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;

      background: #fffdf8;

      font-family: var(--font-serif);
      font-size: clamp(1.45rem, 6vw, 1.85rem);

      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translate3d(100%, 0, 0);

      transition:
        transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
        opacity 260ms ease,
        visibility 0s linear 420ms;
    }

    .site-header__nav::before,
    .site-header__nav::after {
      content: "";
      position: absolute;
      z-index: 0;
      width: 210px;
      height: 210px;
      background: url("/images/decorations/deco5.png") center / contain no-repeat;
      opacity: 0.12;
      pointer-events: none;
    }

    .site-header__nav::before {
      left: -75px;
      top: -35px;
    }

    .site-header__nav::after {
      right: -85px;
      bottom: -45px;
      transform: rotate(180deg);
    }

    .site-header__nav.is-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translate3d(0, 0, 0);
      transition:
        transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
        opacity 260ms ease,
        visibility 0s;
    }

    .site-header__nav > a {
      position: relative;
      z-index: 1;
      flex: 0 0 auto;
    }

    .site-header__nav > a:not(.site-header__cta) {
      width: min(100%, 340px);
      padding: 1rem 0;
      text-align: center;
      border-bottom: 1px solid rgba(64, 101, 86, 0.1);
    }

    .site-header__nav > a:not(.site-header__cta)::after {
      display: none;
    }

    .site-header__cta {
      margin-top: 2rem;
      min-width: 170px;
      min-height: 52px;
      padding-inline: 2rem;
      font-family: var(--font-body);
      font-size: 0.82rem;
      background: var(--terracotta);
      border-color: var(--terracotta);
      color: var(--ivory-light);
    }
  }
</style>
