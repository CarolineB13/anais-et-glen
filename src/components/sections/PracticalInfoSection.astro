<section id="infos" class="infos">
  <img
    src="/images/decorations/deco1.png"
    alt=""
    class="infos__flowers"
    aria-hidden="true"
  />

  <div class="infos__inner">
    <!-- INTRO -->
    <div class="infos__heading">
      <p class="infos__script">Pour que tout soit simple…</p>

      <h2>
        Les petites choses
        <span>à savoir.</span>
      </h2>

      <p class="infos__intro">
        Quelques informations pratiques pour profiter pleinement de la journée
        sans avoir à penser à l’organisation.
      </p>

      <div class="infos__ornament" aria-hidden="true">
        <span></span>
        <i>♡</i>
        <span></span>
      </div>
    </div>

    <!-- FAQ -->
    <div class="infos__faq">
      <!-- 01 -->
      <details class="faq-item">
        <summary>
          <span>Où dormir ?</span>

          <i aria-hidden="true"></i>
        </summary>

        <div class="faq-item__answer">
          <p>
            Si vous avez besoin d’un hébergement, n’hésitez pas à nous en parler
            : nous ferons au mieux pour vous aider à trouver une solution.
          </p>

          <p>
            Vous trouverez également des hôtels et logements dans les environs
            de Gémenos, Aubagne, La Ciotat et Cuges-les-Pins.
          </p>

          <p>
            Le mois de juin étant particulièrement demandé dans la région,
            pensez à réserver suffisamment tôt.
          </p>
        </div>
      </details>

      <!-- 02 -->
      <details class="faq-item">
        <summary>
          <span>Comment se déplacer ?</span>

          <i aria-hidden="true"></i>
        </summary>

        <div class="faq-item__answer">
          <p>
            La journée se déroulera sur plusieurs lieux. Nous vous conseillons
            donc de privilégier le covoiturage lorsque cela est possible.
          </p>

          <p>
            Pensez à anticiper les trajets entre Gémenos, La Ciotat et
            Cuges-les-Pins, particulièrement pendant la période estivale.
          </p>
        </div>
      </details>

      <!-- 03 -->
      <details class="faq-item">
        <summary>
          <span>Et les enfants ?</span>

          <i aria-hidden="true"></i>
        </summary>

        <div class="faq-item__answer">
          <p>Les enfants sont les bienvenus.</p>

          <p>
            Aucune garde ni animation dédiée ne sera toutefois prévue : ils
            resteront donc sous la surveillance de leurs parents.
          </p>

          <p>
            Certains espaces pourront également demander une vigilance
            particulière au cours de la journée et de la soirée.
          </p>
        </div>
      </details>

      <!-- 04 -->
      <details class="faq-item">
        <summary>
          <span>Repas & allergies</span>

          <i aria-hidden="true"></i>
        </summary>

        <div class="faq-item__answer">
          <p>Nous faisons en sorte qu’il y en ait pour tous les goûts.</p>

          <p>
            Si vous avez une allergie ou une contrainte alimentaire importante,
            indiquez-la simplement dans le formulaire RSVP.
          </p>

          <p>
            Nous pourrons ainsi transmettre l’information au traiteur et
            organiser les choses au mieux.
          </p>
        </div>
      </details>

      <!-- 05 -->
      <details class="faq-item">
        <summary>
          <span>Photos & vidéos</span>

          <i aria-hidden="true"></i>
        </summary>

        <div class="faq-item__answer">
          <p>
            Un photographe et un vidéaste seront présents pendant la journée.
          </p>

          <p>
            Mais nous serons aussi ravis de découvrir tous les petits moments
            que vous aurez capturés de votre côté.
          </p>

          <p>
            Une page dédiée permettra de retrouver et partager facilement les
            photos et vidéos du mariage.
          </p>

          <a href="/photos">
            Découvrir l’espace photos
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </details>

      <!-- 06 -->
      <details class="faq-item">
        <summary>
          <span>Un dernier conseil ?</span>

          <i aria-hidden="true"></i>
        </summary>

        <div class="faq-item__answer">
          <p>
            Prévoyez une paire de chaussures dans laquelle vous pourrez vraiment
            danser.
          </p>

          <p>
            Venez avec votre bonne humeur, votre énergie et votre envie de
            profiter : ce sont les seuls accessoires indispensables.
          </p>

          <p>
            Et si vous ne connaissez pas encore tout le monde, quelques
            discussions et quelques pas de danse devraient vite arranger ça.
          </p>
        </div>
      </details>
    </div>
  </div>
</section>
<script>
  const faqItems = document.querySelectorAll(".faq-item");

  faqItems.forEach((item) => {
    const summary = item.querySelector("summary");
    const content = item.querySelector(".faq-item__answer");

    if (!summary || !content) return;

    let animation;
    let isClosing = false;
    let isExpanding = false;

    summary.addEventListener("click", (event) => {
      event.preventDefault();

      item.style.overflow = "hidden";

      if (isClosing || !item.open) {
        // Ferme les autres questions déjà ouvertes
        faqItems.forEach((otherItem) => {
          if (otherItem !== item && otherItem.open) {
            const otherSummary = otherItem.querySelector("summary");

            otherSummary?.click();
          }
        });

        open();
      } else if (isExpanding || item.open) {
        close();
      }
    });

    function close() {
      isClosing = true;

      const startHeight = `${item.offsetHeight}px`;
      const endHeight = `${summary.offsetHeight}px`;

      if (animation) {
        animation.cancel();
      }

      animation = item.animate(
        {
          height: [startHeight, endHeight],
        },
        {
          duration: 460,
          easing: "cubic-bezier(0.22, 1, 0.36, 1)",
        },
      );

      animation.onfinish = () => {
        item.open = false;
        cleanup();
      };

      animation.oncancel = () => {
        isClosing = false;
      };
    }

    function open() {
      item.style.height = `${item.offsetHeight}px`;

      item.open = true;

      requestAnimationFrame(() => {
        expand();
      });
    }

    function expand() {
      isExpanding = true;

      const startHeight = `${item.offsetHeight}px`;

      const endHeight = `${summary.offsetHeight + content.offsetHeight}px`;

      if (animation) {
        animation.cancel();
      }

      animation = item.animate(
        {
          height: [startHeight, endHeight],
        },
        {
          duration: 520,
          easing: "cubic-bezier(0.22, 1, 0.36, 1)",
        },
      );

      animation.onfinish = () => {
        cleanup();
      };

      animation.oncancel = () => {
        isExpanding = false;
      };
    }

    function cleanup() {
      item.style.height = "";
      item.style.overflow = "";

      animation = null;
      isClosing = false;
      isExpanding = false;
    }
  });
</script>
<style>
