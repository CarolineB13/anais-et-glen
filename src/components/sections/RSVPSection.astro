<section id="rsvp" class="rsvp">
  <div class="rsvp__decor rsvp__decor--left" aria-hidden="true">
    <img src="/images/decorations/deco1.png" alt="" />
  </div>

  <div class="rsvp__inner">
    <!-- ===================================
         INTRO
         =================================== -->

    <header class="rsvp__heading">
      <p class="rsvp__script">Et maintenant…</p>

      <h2>
        Serez-vous
        <span>des nôtres ?</span>
      </h2>

      <p class="rsvp__intro">
        Nous espérons de tout cœur pouvoir partager cette journée avec vous.
      </p>

      <div class="rsvp__ornament" aria-hidden="true">
        <span></span>
        <i>♡</i>
        <span></span>
      </div>

      <p class="rsvp__deadline">
        Merci de nous répondre avant le
        <strong> 1er mai 2027</strong>
      </p>
    </header>

    <!-- ===================================
         FORMULAIRE
         =================================== -->

    <div class="rsvp__card">
      <form class="rsvp-form" id="rsvp-form">
        <!-- NOM -->

        <div class="form-field">
          <label for="name"> Votre nom </label>

          <input
            id="name"
            name="name"
            type="text"
            autocomplete="name"
            placeholder="Anaïs Dupont"
            required
          />
        </div>

        <!-- PRESENCE -->

        <fieldset class="form-field form-field--attendance">
          <legend> Serez-vous présent ? </legend>

          <div class="attendance-options">
            <label class="attendance-option">
              <input type="radio" name="attendance" value="yes" required />

              <span class="attendance-option__card">
                <i aria-hidden="true"> ♡ </i>

                <strong> Avec plaisir </strong>

                <small> Comptez sur moi ! </small>
              </span>
            </label>

            <label class="attendance-option">
              <input type="radio" name="attendance" value="no" />

              <span class="attendance-option__card">
                <i aria-hidden="true"> ♡ </i>

                <strong> Malheureusement… </strong>

                <small> Je ne pourrai pas être là </small>
              </span>
            </label>
          </div>
        </fieldset>

        <!-- NOMBRE -->

        <div class="form-row">
          <div class="form-field">
            <label for="adults"> Adultes </label>

            <select id="adults" name="adults">
              <option value="1"> 1 adulte </option>

              <option value="2"> 2 adultes </option>

              <option value="3"> 3 adultes </option>

              <option value="4"> 4 adultes </option>
            </select>
          </div>

          <div class="form-field">
            <label for="children"> Enfants </label>

            <select id="children" name="children">
              <option value="0"> Aucun </option>

              <option value="1"> 1 enfant </option>

              <option value="2"> 2 enfants </option>

              <option value="3"> 3 enfants </option>

              <option value="4"> 4 enfants </option>
            </select>
          </div>
        </div>

        <!-- ALLERGIES -->

        <div class="form-field">
          <label for="diet"> Allergies ou régime alimentaire </label>

          <input
            id="diet"
            name="diet"
            type="text"
            placeholder="Végétarien, allergie aux fruits à coque…"
          />

          <small class="form-field__help">
            Laissez vide si rien à signaler.
          </small>
        </div>

        <!-- MESSAGE -->

        <div class="form-field">
          <label for="message"> Un petit mot pour nous ? </label>

          <textarea
            id="message"
            name="message"
            rows="4"
            placeholder="Promis, on lit tout ♡"></textarea>
        </div>

        <!-- SUBMIT -->

        <button class="rsvp-form__submit" type="submit">
          <span> Envoyer ma réponse </span>

          <i aria-hidden="true"> → </i>
        </button>

        <p class="rsvp-form__demo">
          Site de démonstration — aucune donnée saisie n’est transmise ou
          enregistrée.
        </p>
      </form>

      <!-- ===================================
           CONFIRMATION DEMO
           =================================== -->

      <div class="rsvp-success" id="rsvp-success" hidden>
        <span class="rsvp-success__heart"> ♡ </span>

        <p class="rsvp-success__script">Merci !</p>

        <h3>Voilà ce que verrait votre invité.</h3>

        <p>
          Sur un véritable site de mariage, sa réponse serait alors enregistrée
          et transmise aux mariés.
        </p>

        <span class="rsvp-success__signature"> Anaïs & Glen </span>
      </div>
    </div>
  </div>

  <div class="rsvp__decor rsvp__decor--right" aria-hidden="true">
    <img src="/images/decorations/deco5.png" alt="" />
  </div>
</section>

<script>
  const form = document.querySelector("#rsvp-form");

  const success = document.querySelector("#rsvp-success");

  if (form instanceof HTMLFormElement && success instanceof HTMLElement) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const animation = form.animate(
        [
          {
            opacity: 1,
            transform: "translateY(0)",
          },
          {
            opacity: 0,
            transform: "translateY(-10px)",
          },
        ],
        {
          duration: 350,
          easing: "cubic-bezier(0.22, 1, 0.36, 1)",
          fill: "forwards",
        },
      );

      animation.onfinish = () => {
        form.hidden = true;
        success.hidden = false;

        success.animate(
          [
            {
              opacity: 0,
              transform: "translateY(12px)",
            },
            {
              opacity: 1,
              transform: "translateY(0)",
            },
          ],
          {
            duration: 600,
            easing: "cubic-bezier(0.22, 1, 0.36, 1)",
            fill: "forwards",
          },
        );
      };
    });
  }
</script>

