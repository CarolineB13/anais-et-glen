---
import "../styles/global.css";
import Footer from "../components/navigation/Footer.astro";

const {
  title = "Anaïs & Glen — Mariage",
  description = "Anaïs & Glen vous invitent à célébrer leur mariage.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="description" content={description} />

    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Allura&family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body id="top">
    <slot />
    <Footer />
  </body>
</html>
